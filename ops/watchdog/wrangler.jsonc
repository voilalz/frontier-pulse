{
  "name": "frontier-publication-watchdog",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "vars": {
    "ENABLED": "false",
    "SITE_URL": "https://newsfrontier.top/",
    "GITHUB_REPO": "voilalz/frontier-pulse"
  },
  "triggers": {
    // UTC: Beijing 07:50 / 08:00 / 08:05 / 08:35 / 09:05.
    "crons": ["50 23 * * *", "0,5,35 0 * * *", "5 1 * * *"]
  },
  "durable_objects": {
    "bindings": [{"name": "WATCHDOG", "class_name": "PublicationWatchdog"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PublicationWatchdog"]}],
  "observability": {"enabled": true}
}
